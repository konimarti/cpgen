module cpgen;
import std::io, std::encoding::hex, std::collections::list, std::sort;

fn int usage()
{
	io::printfn("cpgen <directory>");
	return 0;
}

struct Emitter
{
	OutStream out;
}
fn Emitter* Emitter.init(&self, OutStream out = io::stdout())
{
	self.out = out;
	return self;
}

fn int main(String[] args) => @pool()
{
	if (args.len < 2) return usage();
	Path path = path::temp(args[1])!!;
	if (!path::is_dir(path)) return usage();
	emit_core_module(io::stdout())!!;
	path.walk(&walker, (Emitter){}.init(io::stdout()))!!;
	return 0;
}

fn bool? walker(Path current_path, bool is_dir, void* arg) => @pool()
{
	Emitter *e = (Emitter*)arg;
	if (!is_dir) emit_codepage_module(current_path, e.out)!;
	return false;
}


fn void? emit_core_module(OutStream out)
{

io::fprintfn(out, `// Copyright (c) 2026 Koni Marti. All rights reserved.
// Use of this source code is governed by the MIT license.
// Auto-generated by cpgen on %s %s.`, $$DATE, $$TIME);

(void)io::fprintn(out, `module std::encoding::codepage;
import std::sort;

struct CodePageTable
{
	CodePageUnicode[256] to_utf8;
	uint[256]            from_utf8;
}

struct CodePageUnicode
{
	char[4] bytes;
	usz     len;
}
fn char[] CodePageUnicode.symbol(&self) @inline => self.bytes[:self.len];

<*
 @param [&inout] allocator : "Allocator."
 @param [&inout] cp        : "Code page table."
 @param src                : "Input byte array encoded in the given code page."
 @return "String in UTF-8."
*>
fn String? decode_to_utf8(Allocator allocator, CodePageTable *cp, char[] src)
{
	DString buf = dstring::new(allocator);
	foreach (c: src)
	{
		buf.append_bytes(cp.to_utf8[c].symbol());
	}
	return buf.str_view();
}

<*
 @param [&inout] allocator : "Allocator."
 @param [&inout] cp        : "Code page table."
 @param src                : "UTF-8 byte array to be encoded."
 @return "String encoded in the given code page."
*>
fn String? encode_to_utf8(Allocator allocator, CodePageTable *cp, char[] src)
{
	DString buf = dstring::new(allocator);

	usz n = src.len;
	for (usz i = 0; i < n;)
	{
		usz rem = n - i;
		rem = rem < 4 ? rem : 4;
		Char32 codepoint = conv::utf8_to_char32(&src[i], &rem)!!;
		i += rem;

		usz index = sort::binarysearch(cp.from_utf8[..], (uint)codepoint,
		fn int(uint a, uint b){
			uint mask = (1 << 24) - 1;
			return (a&mask) - (b&mask);
		});

		uint encoded = cp.from_utf8[index];
		char byte = (char)(encoded >> 24);
		uint unicode = encoded & ((1<<24)-1);
		assert (unicode == (uint)codepoint, "i: %d, got: 0x%08x, want: 0x%08x", i, unicode, (uint)codepoint);
		buf.append_char(byte);
	}
	return buf.str_view();
}

module std::encoding::codepage_test;

import std::encoding::codepage::cp437;

fn void test_cp437() @test
{
	String want = "╔══════════════════════════════════════╗"
                      "║  SYSTEM STATUS: OK - 25°C ± 2°C      ║"
                      "║  Café Menu: Crème Brûlée .... £5.00  ║"
                      "╚══════════════════════════════════════╝";

	char[] bytes = x"C9CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDBB"
		x"BA202053595354454D205354415455533A204F4B202D203235F84320F12032F843202020202020BA"
		x"BA202043616682204D656E753A2043728A6D65204272966C8265202E2E2E2E209C352E30302020BA"
		x"C8CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDBC";

	@pool()
	{
		String got = (String)cp437::decode(tmem, bytes)!!;
		assert(got == want, "cp437 decoding failed: got=%s, want=%s", got, want);
		got = (String)cp437::encode(tmem, got[..])!!;
		assert(got == (String)bytes, "cp437 encoding failed: got=%s, want=%s", got, (String)bytes);

	};
}
`);
}

<*
 Codepoint stores an 8-bit character in the given codepage with the equivalent
 unicode value.
*>
struct Codepoint
{
	char   byte;    // Character
	uint   unicode; // Unicode
}
<*
 Compares the unicode values.
*>
fn bool Codepoint.less(&self, Codepoint other) => self.unicode < other.unicode;

fn void? emit_codepage_module(Path p, OutStream out) => @pool()
{
	// Prepare code page name.
	String cp_name = p.basename().tcopy();
	cp_name.convert_to_lower();
	if (!cp_name.ends_with(".txt")) return;
	cp_name = cp_name.strip_end(".txt");
	foreach (&c : cp_name)
	{
		if (!c.is_alnum()) *c = '_';
	}
	String prefix;
	if (cp_name.starts_with("8859"))
	{
		prefix = "iso_";
	}
	else if (cp_name[0].is_digit())
	{
		prefix = "cp";
	}
	cp_name = string::tformat("%s%s", prefix, cp_name);

	// Open file
	File f = file::open_path(p, "r")!;
	defer (void)f.close();

	List{String} doc_comment;
	doc_comment.tinit();
	usz empty_comment_lines = 0;

	// Read code page.
	Codepoint[256] cps;
	usz i = 0;
	while (try line = io::treadline(&f))
	{
		if (try hash = line.index_of_char('#'))
		{
			String comment = line[hash+1..].trim();
			if (!comment.len) empty_comment_lines++;
			if (comment.len && empty_comment_lines < 2)
			{
				doc_comment.push(comment);
			}
			line = line[:hash];
		}
		if (!line.trim().len) continue;
		String[] parts = line.tsplit("\t", skip_empty: true);
		usz len = parts.len;
		switch (parts.len)
		{
			case 2:
				String byte = parts[0].trim();
				String uni  = parts[1].trim();
				if (!byte.len || !uni.len) break;
				if (try plus = uni.index_of_char('+')) uni = uni[:plus];
				if (byte.contains("+")) break;
				cps[i] = { byte.to_uchar()!, uni.to_uint()! };
			case 1:
				if (!parts[0].trim().len) break;
				cps[i] = { parts[0].to_uchar()!, 0x1a };
		}
		i++;
		if (i >= 256) break;
	}
	uint[256] utf8_dec = gen_decode_table(&cps)!;
	io::fprintfn(out, "\n<*");
	io::fprintfn(out, " Module containing the codepage table for %s.\n", cp_name);
	io::fprintfn(out, " %s", string::join(tmem, doc_comment.array_view(), "\n "));
	io::fprintfn(out, "\n*>");
	io::fprintfn(out, "module std::encoding::codepage::%s;\n", cp_name);
	io::fprintfn(out, "fn char[]? decode(Allocator allocator, char[] bytes) @inline\n{");
	io::fprintfn(out, "\treturn codepage::decode_to_utf8(allocator, &%s, bytes);", cp_name);
	io::fprintfn(out, "\n}");
	io::fprintfn(out, "fn char[]? tdecode(Allocator allocator, char[] bytes) => decode(tmem, bytes)!;\n");
	io::fprintfn(out, "fn char[]? encode(Allocator allocator, char[] bytes) @inline\n{");
	io::fprintfn(out, "\treturn codepage::encode_to_utf8(allocator, &%s, bytes);", cp_name);
	io::fprintfn(out, "\n}");
	io::fprintfn(out, "fn char[]? tencode(Allocator allocator, char[] bytes) => encode(tmem, bytes)!;\n");

	io::fprintfn(out, "CodePageTable %s @private = {", cp_name);

	// Write out CodePageTable.utf8_enc.
	io::fprintfn(out, "\t.to_utf8 = {");
	(void)io::fprint(out, "\t");
	foreach (j, cp: cps)
	{
		char[4] utf8;
		if (try n = conv::char32_to_utf8((Char32)cp.unicode, &utf8))
		{
			(void)io::fprintf(out, "{ x\"%s\", %d }", hex::tencode(utf8[..]), n);
			if (j < 255) (void)io::fprintf(out, ",");
		}
		(void)io::fprintf(out, (j+1) % 4 == 0 ? "\n\t" : " ");
	}
	io::printn("},");

	// Write out CodePageTable.utf8_dec.
	io::fprintfn(out, "\t.from_utf8 = {");
	(void)io::fprint(out, "\t");
	foreach (j, decode: utf8_dec)
	{
		(void)io::fprintf(out, "0x%08x", decode);
		if (j < 255) (void)io::fprintf(out, ",");
		(void)io::fprintf(out, (j+1) % 6 == 0 ? "\n\t" : " ");
	}
	io::printn("\t}");
	io::printn("};");
}

fn uint[256]? gen_decode_table(Codepoint[256] *cps)
{
	uint[256] dec_table;
	// Pack the decode table (highest byte is the charset byte, the lower 3
	// bytes contain the unicode.
	foreach (i, cp: cps)
	{
		dec_table[i] = cp.byte << 24 | cp.unicode;
	}
	// Sort table by unicode so that we can use a binary search in the
	// decoding.
	sort::quicksort(&dec_table, fn int(uint a, uint b){ uint mask = (1<<24)-1; return (a&mask) - (b&mask);});
	return dec_table;
}
