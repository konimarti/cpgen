module cpgen;
import std::io, std::encoding, std::collections, std::sort;

fn int String.compare_to(&self, String rhs)
{
       String lhs = *self;

       usz i = 0;
       while (i < lhs.len && i < rhs.len)
       {
               if (lhs[i] < rhs[i]) return -1;
               if (lhs[i] > rhs[i]) return 1;
               i++;
       }
       if (lhs.len < rhs.len) return -1;
       if (lhs.len > rhs.len) return 1;
       return 0;
}

fn int usage()
{
	io::printfn(`
	cpgen <path..>

	Generate C3 code-page tables for the provided mapping files.

	Save the public API in './output/codepage.c3', private data in
	'/.output/codepage_private.c3', and test module in
	'./output/codepage_test.c3'.

	`);
	return 0;
}

struct Emitter
{
	Allocator allocator;
	Path public;
	Path private;
	Path tests;
	List{String} cp_modules;
	HashMap{String, String} files;
}

fn void Emitter.init(&self, Allocator allocator)
{
	self.allocator = allocator;
	self.cp_modules.init(allocator);
	self.files.init(allocator);
}

fn void Emitter.free(&self) => self.cp_modules.free();

fn int main(String[] args) => @pool()
{
	Path target_folder = path::temp("output")!!;
	path::mkdir(target_folder, recursive: true)!!;

	Emitter e;
	e.init(tmem);
	e.public  = target_folder.tappend("codepage.c3")!!;
	e.private = target_folder.tappend("codepage_private.c3")!!;
	e.tests   = target_folder.tappend("codepage_test.c3")!!;

	foreach (arg : args[1..])
	{
		Path path = path::temp(arg)!!;
		if (path::is_dir(path))
		{
			path.walk(&load_file_list, &e)!!;
			continue;
		}
		load_file_list(path, false, &e)!!;
	}

	// Sort file list.
	sort::quicksort(e.cp_modules.array_view());

	// Emit core parts.
	e.emit_core()!!;

	// Convert mapping files and emit.
	File out = file::open_path(e.private, "a")!!;
	defer (void)out.close();

	foreach (cp_name: e.cp_modules)
	{
		if (try current_path = e.files[cp_name])
		{
			e.emit_codepage_module(path::temp(current_path)!!, cp_name, &out)!!;
		}
	}

	return 0;
}

fn bool? load_file_list(Path current_path, bool is_dir, void* arg) => @pool()
{
	Emitter *e = (Emitter*)arg;
	if (is_dir) return false; // Continue.

	// Prepare code-page name.
	String? cp_name = code_page_name(tmem, current_path);
	if (catch cp_name) return false; // Skip file and continue.

	if (e.cp_modules.contains(cp_name))
	{
		io::eprintf("Duplicate module found: %s\n", cp_name);
		usz i = 2;
		String candidate = cp_name;
		while (e.cp_modules.contains(candidate))
		{
			candidate = string::tformat("%s_%d", cp_name, i);
			i++;
		}
		cp_name = candidate;
		io::eprintf("Assigning new name: %s\n", cp_name);
	}
	String cp_name_cpy = cp_name.copy(e.allocator);
	e.cp_modules.push(cp_name_cpy);
	e.files[cp_name_cpy] = current_path.str_view().copy(e.allocator);

	return false;
}

faultdef SKIP_FILE;

fn String? code_page_name(Allocator allocator, Path path) => @pool()
{
	String cp_name = path.basename().tcopy();
	cp_name.convert_to_lower();

	if (!cp_name.ends_with(".txt"))
	{
		io::eprintfn("Skipping file: %s", path.str_view());
		return SKIP_FILE~;
	}
	cp_name = cp_name.strip_end(".txt");

	foreach (&c : cp_name)
	{
		if (!c.is_alnum()) *c = '_';
	}

	String prefix;
	if (cp_name.starts_with("8859"))
	{
		prefix = "iso_";
	}
	else if (cp_name[0].is_digit())
	{
		prefix = "cp";
	}
	return string::format(allocator, "%s%s", prefix, cp_name);
}

fn void? Emitter.emit_core(&self)
{
	File out = file::open_path(self.public, "w")!;
	self.emit_core_module(&out)!;
	(void)out.close();

	out = file::open_path(self.tests, "w")!;
	self.emit_test_module(&out)!;
	(void)out.close();

	out = file::open_path(self.private, "w")!;
	self.emit_disclaimer(&out, true);
	io::fprintfn(&out, "<*");
	io::fprintfn(&out, " Private module containing the codepage tables.");
	io::fprintfn(&out, "*>");
	io::fprintfn(&out, "module std::encoding::codepage @private;\n");
	(void)out.close();
}

fn void Emitter.emit_disclaimer(&self, OutStream out, bool auto = false)
{
io::fprintfn(out, `// Copyright (c) 2026 Koni Marti. All rights reserved.
// Use of this source code is governed by the MIT license.`);
if (auto)
{
	io::fprintfn(out, "// Auto-generated by cpgen on %s %s.", $$DATE, $$TIME);
}
}

fn void? Emitter.emit_core_module(&self, OutStream out) => @pool()
{
self.emit_disclaimer(out);

io::fprintfn(out, `<*
 Module providing generic single‑byte code page to UTF‑8 conversion.

 This module implements a compact, table‑driven approach for single-byte
 (8‑bit) encodings (e.g. CP437, CP850, CP866, CP125x). It is designed so
 that each concrete code page only needs to supply a small, static
 mapping table; the conversion logic is shared.

 The design has two main goals:

 - Fast decode from code page to UTF‑8 with a single table lookup per byte.
 - Memory‑efficient encode from UTF‑8 to code page without a large
   Unicode‑to‑byte array (no 64k reverse map per code page).

 The design of CodePageTable and the packed reverse mapping is conceptually
 similar to golang.org/x/text/encoding/charmap.

 *>`)!;

io::fprintn(out, `module std::encoding::codepage;
import std::sort;

<*
 Default replacement byte used when encoding from UTF‑8 to a single‑byte
 code page and a Unicode scalar cannot be represented.

 By convention, 0x1A is the ASCII/IBM SUB (substitute) control character.
*>
const char REPLACEMENT_CHAR = 0x1a;

<*
 CodePageTable contains the bidirectional mapping tables for a single‑byte code
 page in a compact packed form.

 to_codepoint is the forward map from code‑page byte (0x00–0xFF) to its UTF‑8
 sequence. The array index is the raw byte value, each entry occupying 4 bytes:

   - Byte 0 is the length of the UTF‑8 sequence (0–4)
   - Bytes 1:len are the UTF‑8 bytes for the mapped Unicode scalar

 The table therefore uses 256 * 4 bytes and is stored as a flat
 char[1024] array, where entry i starts at offset i*4.

 from_codepoint is the reverse map from Unicode scalar value to code‑page byte,
 also stored as a packed char[1024] array. It contains 256 entries of 4 bytes
 each, where each 4‑byte chunk is interpreted as a little‑endian uint
 with the following packing scheme:

     high 8 bits = code‑page byte value (0x00–0xFF)
     low 24 bits = Unicode scalar value (code point)

 In other words:

     entry = (byte_value << 24) | codepoint;

 Ordering:
   The 256 packed uint entries in from_codepoint are sorted by the low 24 bits
   (code points). This allows binary search over Unicode scalar values without
   a 64k reverse‑lookup table. For any given code page, there are at most
   256 mappings, so a log2(256) or 8 step search is sufficient.
*>
struct CodePageTable
{
    char[1024] to_codepoint;
    char[1024] from_codepoint;
}
`)!;

// Emit CodePage enum.
io::fprintn(out, `<* Returns a CodePageTable for the given charset name. *>
fn CodePageTable*? charset(String charset_name) => @pool()
{
	String name = charset_name.treplace("_","-");
	name.convert_to_lower();
	switch (name)
	{`)!;

foreach (cp_name: self.cp_modules)
{
	String cp_name_dash = cp_name.treplace("_","-");
	String cp_name_upper = cp_name.to_upper_copy(tmem);
	io::fprintfn(out, "\t\tcase \"%s\": return &%s;", cp_name_dash, cp_name_upper)!;
}

io::fprintn(out, `		default: return NOT_FOUND~;
	}
}
`)!;


io::fprintn(out, `
fn String? decode(Allocator allocator, char[] src, CodePageTable *table)
{
	char[] dst = allocator::alloc_array(allocator, char, decode_len(src, table));
	return decode_buffer(src, dst, table);
}

<*
 Decode a code-page byte buffer into a UTF‑8 string.

 @param src            : "Input byte array in the given code page."
 @param dst            : "Destination output string in UTF-8."
 @param [&inout] table : "Code page table describing the mapping for this encoding."
 @return "String in UTF-8."
*>
fn String? decode_buffer(char[] src, char[] dst, CodePageTable *table)
{
	usz n = 0;
	foreach (c: src)
	{
		usz pos = (usz)c * 4;
		char len = table.to_codepoint[pos];

		dst[n:len] = table.to_codepoint[pos+1:len];
		n += len;
	}

	return (String)dst[:n];
}

fn char[]? encode(Allocator allocator, char[] src, CodePageTable *table,
	char replacement = REPLACEMENT_CHAR)
{
	char[] dst = allocator::alloc_array(allocator, char, encode_len(src));
	return encode_buffer(src, dst, table, replacement);
}

const uint MASK @private = (1u << 24) - 1;

<*
 Encode a UTF‑8 string into a single‑byte code page.

 @param src            : "Input byte array in UTF-8"
 @param dst            : "Destination output byte array in the target code page"
 @param [&inout] table : "Code page table describing the mapping for this encoding."
 @param replacement    : "Byte to emit when Unicode scalar cannot be represented in the target code page."
 @return "Byte array in the given code page."
*>
fn char[]? encode_buffer(char[] src, char[] dst, CodePageTable *table,
	char replacement = REPLACEMENT_CHAR)
{
	// Unpack the packed reverse table once into a local uint[256] view.
	uint[256] from_map;
	for (usz i = 0; i < 256; i++)
	{
	    UIntLE *val = (UIntLE*)&table.from_codepoint[i * 4];
	    from_map[i] = mem::load(val, 1).val;
	}

	usz out = 0;
	usz n = src.len;
	for (usz i = 0; i < n; )
	{
		usz rem = n - i;
		if (rem > 4) rem = 4;

		Char32 codepoint = conv::utf8_to_char32(&src[i], &rem)!;
		i += rem;

		// Binary search for codepoint in low 24 bits of each entry.
		// Returned index is between [0..from_map.len).
		usz index = sort::binarysearch(from_map[..], (uint)codepoint,
		    fn int(uint lhs, uint rhs) => (int)(lhs & MASK) - (int)(rhs & MASK));

		uint entry = from_map[index];
		if ((entry & MASK) == (uint)codepoint)
		{
		    char b = (char)(entry >> 24);
		    dst[out++] = b;
		}
		else
		{
		    dst[out++] = replacement;
		}
	}

	return dst[:out];
}

<*
 Compute the number of UTF‑8 bytes produced when decoding src with the given
 code page table.
 @param src                : "Input byte array in the given code page."
 @param [&inout] table     : "Code page table describing the mapping for this encoding."
*>
fn usz decode_len(char[] src, CodePageTable *table) @inline
{
	usz n;
	foreach (usz c: src) n += table.to_codepoint[c*4];
	return n;
}

<*
 Compute the number of output bytes produced when
 encoding src from UTF‑8 to a single‑byte code page.
 @param src                : "Input byte array in UTF-8"
*>
fn usz encode_len(char[] src) @inline
{
	return conv::utf8_codepoints((String)src);
}
`)!;
}

fn void? Emitter.emit_test_module(&self, OutStream out)
{
	self.emit_disclaimer(out);

io::fprintn(out, `module std::encoding::codepage_test;
import std::encoding::codepage;

fn void test_cp437() @test
{
	String want = "╔══════════════════════════════════════╗"
                      "║  SYSTEM STATUS: OK - 25°C ± 2°C      ║"
                      "║  Café Menu: Crème Brûlée .... £5.00  ║"
                      "╚══════════════════════════════════════╝";

	char[] bytes =
	x"C9CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDBB"
	x"BA202053595354454D205354415455533A204F4B202D203235F84320F12032F843202020202020BA"
	x"BA202043616682204D656E753A2043728A6D65204272966C8265202E2E2E2E209C352E30302020BA"
	x"C8CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDBC";

	@pool()
	{
		String got = codepage::decode(tmem, bytes, codepage::charset("cp437"))!!;
		assert(got == want, "cp437 decoding failed: got=%s, want=%s", got, want);

		got = (String)codepage::encode(tmem, got[..], codepage::charset("cp437"))!!;
		assert(got == (String)bytes, "cp437 encoding failed: got=%s, want=%s",
			got, (String)bytes);

	};
}

fn void test_cp437_roundtrip() @test
{
    String s = "╔══ CP437: Café, π≈3.14 ══╗";
    check_roundtrip(s, "cp437");
}

fn void test_cp850_roundtrip() @test
{
    String s = "CP850: Crème Brûlée, Frühstück, £10.50";
    check_roundtrip(s, "cp850");
}

fn void test_cp866_roundtrip() @test
{
    String s = "CP866: Привет мир!";
    check_roundtrip(s, "cp866");
}

fn void test_cp863_roundtrip() @test
{
    String s = "CP863: Québec, érable, Noël";
    check_roundtrip(s, "cp863");
}

fn void test_iso8859_1() @test
{
    String s = "ISO-8859-1: Café, Ångström, Straße, Noël, £10.50";
    check_roundtrip(s, "iso-8859-1");
}

fn void test_iso8859_2_polish() @test
{
    String s = "Polski: Zażółć gęślą jaźń";
    check_roundtrip(s, "iso-8859-2");
}

fn void test_iso8859_2_czech() @test
{
    String s = "Česky: Příliš žluťoučký kůň úpěl ďábelské ódy";
    check_roundtrip(s, "iso-8859-2");
}

fn void test_iso8859_2_hungarian() @test
{
    String s = "Magyar: Árvíztűrő tükörfúrógép";
    check_roundtrip(s, "iso-8859-2");
}

fn void check_roundtrip(String utf8, String charset) => @pool()
{
	CodePageTable *table = codepage::charset(charset)!!;

	// Encode UTF‑8 to code page.
	char[] bytes = codepage::encode(tmem, utf8[..], table)!!;

	// Decode back to UTF‑8 and compare.
	String got = codepage::decode(tmem, bytes, table)!!;

	assert(got == utf8,
		"roundtrip failed: got=%s, want=%s", got, utf8);
}
`)!;
}

<*
 Mapping stores an 8-bit character from the given code page with the
 corresponding Unicode scalar.
*>
struct Mapping
{
	char   byte;    // Code-page byte.
	uint   unicode; // Unicode scalar.
}
<*
 Compares two Mapppings (the Unicode scalars).
*>
fn bool Mapping.less(&self, Mapping other) => self.unicode < other.unicode;

fn void? Emitter.emit_codepage_module(&self, Path mapping, String cp_name, OutStream out) => @pool()
{
	// Open file
	File f = file::open_path(mapping, "r")!;
	defer (void)f.close();

	List{String} doc_comment;
	doc_comment.tinit();
	usz empty_comment_lines = 0;

	// Read code page.
	Mapping[256] cps;
	usz i = 0;
	while (try line = io::treadline(&f))
	{
		if (try hash = line.index_of_char('#'))
		{
			String comment = line[hash+1..].trim();
			if (!comment.len) empty_comment_lines++;
			if (comment.len && empty_comment_lines < 2)
			{
				doc_comment.push(comment);
			}
			line = line[:hash];
		}
		line = line.trim();
		if (!line.len) continue;

		String[] parts = line.tsplit("\t", skip_empty: true);
		if (!parts.len) continue;

		String lhs = parts[0].trim();
		if (!lhs.len || lhs  == "\x1a") continue;

		char left = lhs.to_uchar()!!;
		uint right = 0;

		if (parts.len > 1)
		{
			String rhs = parts[1].trim();
			if (try plus = rhs.index_of_char('+'))
			{
				io::eprintfn("%s (pos %d): stripping everything "
				"after +: %s -> %s", mapping.str_view(), i, rhs, rhs[:plus]);
				rhs = rhs[:plus];
			}
			right = rhs.to_uint()!;
		}

		cps[left] = { left, right };
		i++;
	}

	assert(i <= 256, "More than 256 bytes read.");

	// Encode to_utf_map.
	i = 0;
	char[1024] to_utf_map;
	foreach (cp: cps)
	{
		char[4] utf8;
		if (try n = conv::char32_to_utf8((Char32)cp.unicode, &utf8))
		{
			assert (n != 4);
			to_utf_map[i] = (char)n;
			to_utf_map[i+1:3] = utf8[:3];
		}
		i += 4;
	}
	String to_b64 = base64::tencode(to_utf_map[..]);

	// Encode from_utf_map.
	i = 0;
	char[1024] from_utf_map;
	foreach (sorted_codepoint: gen_decode_table(&cps)!)
	{
		from_utf_map[i++] = (char)sorted_codepoint;
		from_utf_map[i++] = (char)(sorted_codepoint>>8);
		from_utf_map[i++] = (char)(sorted_codepoint>>16);
		from_utf_map[i++] = (char)(sorted_codepoint>>24);
	}
	String from_b64 = base64::tencode(from_utf_map[..]);

	String cp_name_upper = cp_name.to_upper_copy(tmem);

	io::fprintfn(out, "<*");
	// io::fprintfn(out, " Module containing the codepage table for %s.\n", cp_name);
	io::fprintfn(out, " Header from the original mappings file:");
	io::fprintfn(out, " %s", string::join(tmem, doc_comment.array_view(), "\n "));
	io::fprintfn(out, "\n*>");
	// io::fprintfn(out, "module std::encoding::codepage::%s;\n", cp_name);
	// io::fprintfn(out, "fn String? decode(Allocator allocator, char[] src) @inline\n{");
	// io::fprintfn(out, "\treturn codepage::decode_codepage(allocator, src, &%s);", cp_name_upper);
	// io::fprintfn(out, "\n}");
	// io::fprintfn(out, "fn String? tdecode(char[] src) @inline => decode(tmem, src)!;\n");
	// io::fprintfn(out, "fn char[]? encode(Allocator allocator, char[] src, char replacement = codepage::REPLACEMENT_CHAR) @inline\n{");
	// io::fprintfn(out, "\treturn codepage::encode_codepoints(allocator, src, &%s, replacement);", cp_name_upper);
	// io::fprintfn(out, "\n}");
	// io::fprintfn(out, "fn char[]? tencode(char[] src, char replacement = codepage::REPLACEMENT_CHAR) @inline => encode(tmem, src, replacement)!;\n");

	// io::fprintfn(out, "const CodePageTable %s @private = {", cp_name_upper);
	io::fprintfn(out, "const CodePageTable %s = {", cp_name_upper);

	// Write CodePage.utf8_enc.
	io::fprint(out, "\t.to_codepoint = b64`")!;
	print_with_hard_wrap(out, to_b64, 80, 28)!;
	io::fprintn(out, "`,")!;

	// Write CodePage.utf8_dec.
	io::fprintf(out, "\t.from_codepoint = b64`")!;
	print_with_hard_wrap(out, from_b64, 80, 30)!;
	io::fprintn(out, "`\n};\n")!;
}

fn void? print_with_hard_wrap(OutStream out, String s, usz line_max, usz used = 0)
{
	usz i, n;
	i = 0;
	n = s.len;
	while (i < n)
	{
		usz need = line_max - used;
		usz available = n - i;
		need = available > need ? need : available;;
		io::fprintf(out, "%s%s", i>0 ? "\t" : "", s[i:need])!;
		if (i+need < n) io::fprint(out, "\n")!;
		used = 8;
		i += need;
	}
}

fn uint[256]? gen_decode_table(Mapping[256] *cps)
{
	uint[256] dec_table;
	// Pack the decode table (highest byte is the charset byte, the lower 3
	// bytes contain the unicode.
	foreach (cp: cps)
	{
		dec_table[cp.byte] = cp.byte << 24 | cp.unicode;
	}
	// Sort table by unicode so that we can use a binary search in the
	// decoding.
	sort::quicksort(&dec_table, fn int(uint a, uint b){ uint mask = (1<<24)-1; return (a&mask) - (b&mask);});
	return dec_table;
}
