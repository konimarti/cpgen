module cpgen;
import std::io, std::encoding::hex, std::collections::list, std::sort;
import getopt;

fn int usage()
{
	io::printfn(`
	cpgen [ -m ] [ -s ] <source_directory..>

	Generate C3 code page tables for the provided 8-bit mappings.

	-m   Emit only charset mapping.
	-s   Create a separate file for each mapping in folder ./output.

	`);
	return 0;
}

struct Emitter
{
	Allocator allocator;
	bool separate_files;
	bool emit_mapping_only;
	Path code_page_path;
	List{String} cp_modules;
}

fn void Emitter.init(&self, Allocator allocator)
{
	self.allocator = allocator;
	self.separate_files = false;
	self.cp_modules.init(allocator);
}

fn void Emitter.free(&self) => self.cp_modules.free();

fn int main(String[] args) => @pool()
{

	bool separate_files = false;
	bool emit_mapping_only = false;

	String target_folder = "output";

	int optind;
	if (try opts = getopt::getopts(tmem, args, "ms", &optind))
	{
		foreach (opt: opts)
		{
			switch (opt.flag)
			{
				case 'm': emit_mapping_only = true;
				case 's': separate_files = true;
			}
		}
	}
	else
	{
		return usage();
	}

	Emitter e;
	e.init(tmem);
	e.separate_files = separate_files;
	e.emit_mapping_only = emit_mapping_only;
	e.prepare_core_module(target_folder)!!;

	foreach (arg : args[optind..])
	{
		Path path = path::temp(arg)!!;
		if (path::is_dir(path))
		{
			path.walk(&convert_mapping_file, &e)!!;
			continue;
		}
		convert_mapping_file(path, false, &e)!!;
	}
	return 0;
}

fn bool? convert_mapping_file(Path current_path, bool is_dir, void* arg) => @pool()
{
	Emitter *e = (Emitter*)arg;
	if (is_dir) return false; // Continue.

	// Prepare code page name.
	String? cp_name = code_page_name(tmem, current_path);
	if (catch cp_name) return false; // Skip file and continue.

	if (e.cp_modules.contains(cp_name))
	{
		io::eprintf("Duplicate module found: %s\n", cp_name);
		usz i = 2;
		String candidate = cp_name;
		while (e.cp_modules.contains(candidate))
		{
			candidate = string::tformat("%s_%d", cp_name, i);
			i++;
		}
		cp_name = candidate;
		io::eprintf("Assigning new name: %s\n", cp_name);
	}
	e.cp_modules.push(cp_name.copy(e.allocator));

	// Generate and emit new code page module.
	if (e.separate_files)
	{
		String filename = string::tformat("%s.c3", cp_name);
		File out = file::open_path(e.code_page_path.tappend(filename), "w")!;
		e.emit_codepage_module(current_path, cp_name, &out)!;
		(void)out.close();
	}
	else
	{
		e.emit_codepage_module(current_path, cp_name, io::stdout())!;
	}

	return false;
}

faultdef SKIP_FILE;

fn String? code_page_name(Allocator allocator, Path path) => @pool()
{
	String cp_name = path.basename().tcopy();
	cp_name.convert_to_lower();

	if (!cp_name.ends_with(".txt"))
	{
		io::eprintfn("Skipping file: %s", path.str_view());
		return SKIP_FILE~;
	}
	cp_name = cp_name.strip_end(".txt");

	foreach (&c : cp_name)
	{
		if (!c.is_alnum()) *c = '_';
	}

	String prefix;
	if (cp_name.starts_with("8859"))
	{
		prefix = "iso_";
	}
	else if (cp_name[0].is_digit())
	{
		prefix = "cp";
	}
	return string::format(allocator, "%s%s", prefix, cp_name);
}

fn void? Emitter.prepare_core_module(&self, String target_folder)
{
	if (self.separate_files)
	{
		// Create target directory structure
		Path core_module_path;
		if (!target_folder.is_absolute_path() ?? false)
		{
			core_module_path = path::tcwd()!.tappend(target_folder)!;
		}
		else
		{
			core_module_path = path::temp(target_folder)!;
		}
		self.code_page_path = core_module_path.tappend("codepages")!;
		path::mkdir(self.code_page_path, recursive: true)!;

		// Emit core module to ./output/codepage.c3
		if (!self.emit_mapping_only)
		{
			File out = file::open_path(core_module_path.tappend("codepage.c3"), "w")!;
			self.emit_core_module(&out)!;
			(void)out.close();
			out = file::open_path(core_module_path.tappend("codepage_test.c3"), "w")!;
			self.emit_test_module(&out)!;
			(void)out.close();
		}
	}
	else
	{
		// Emit core module to stdout.
		if (!self.emit_mapping_only)
		{
			self.emit_core_module(io::stdout())!;
			self.emit_test_module(io::stdout())!;
		}
	}
}

fn void Emitter.emit_disclaimer(&self, OutStream out)
{
io::fprintfn(out, `// Copyright (c) 2026 Koni Marti. All rights reserved.
// Use of this source code is governed by the MIT license.
// Auto-generated by cpgen on %s %s.`, $$DATE, $$TIME);
}

fn void? Emitter.emit_core_module(&self, OutStream out) => @pool()
{
self.emit_disclaimer(out);

io::fprintfn(out, `<*
 Module providing generic single‑byte code page to UTF‑8 conversion.

 This module implements a compact, table‑driven approach for legacy
 8‑bit encodings (e.g. CP437, CP850, CP866, CP125x). It is designed so
 that each concrete code page only needs to supply a small, static
 mapping table; the conversion logic is shared.

 The design has two main goals:

 - Fast decode from codepage to UTF‑8 with a single table lookup per byte.
 - Memory‑efficient encode from UTF‑8 to codepage without a large
   Unicode‑to‑byte array (no 64k reverse map per codepage).

 The design of CodePage and the packed reverse mapping is
 conceptually similar to golang.org/x/text/encoding/charmap.
 *>`)!;

io::fprintn(out, `module std::encoding::codepage;
import std::sort;

const uint MASK @private = (1u << 24) - 1;

<*
 Bidirectional mapping tables for a single‑byte code page.

 to_codepoint is the forward map from codepage byte (0x00–0xFF) to its UTF‑8
 sequence. The array index is the raw byte value. Each entry is a CodePointUtf8
 with the UTF‑8 bytes and their length.

 from_codepoint is the reverse map from Unicode scalar value to codepage byte,
 stored in a compact, sorted form to keep memory usage low.

   Packing scheme:
     Each uint entry encodes both the codepage byte and the Unicode
     scalar:

         high 8 bits = codepage byte value (0x00–0xFF)
         low 24 bits = Unicode scalar value (code point)

     Example:
         entry = (byte_value << 24) | codepoint;

   Ordering:
     The table is sorted by the low 24 bits (codepoint). This allows
     binary search over the Unicode scalar values without a 64k
     reverse‑lookup table. For any given codepage, there are at most
     256 mappings, so a log2(256) or ~8 step search is enough.

   Usage in encoding (UTF‑8 to codepage):
     1. Decode one Unicode scalar from the UTF‑8 input.
     2. Binary‑search for an entry whose low 24 bits equal
        that scalar.
     3. If found, extract the codepage byte from the high 8 bits and
        emit it.
     4. If not found, emit a caller‑supplied replacement byte (typically
        0x1A / SUB).

   This representation trades a small amount of per‑character CPU
   (binary search) for a very compact, cache‑friendly table.
*>
struct CodePageTable
{
    CodePoint[256] to_codepoint;
    uint[256]      from_codepoint;
}

<*
 UTF‑8 representation of a single code point.

 Each entry stores up to 4 UTF‑8 bytes in bytes and the number of
 bytes actually used in len. This avoids recomputing the UTF‑8
 encoding at runtime.

 For single‑byte code pages, all mapped Unicode values are in the BMP,
 so at most 3 bytes are needed, but 4 bytes are reserved for symmetry.
*>
struct CodePoint
{
	char[4] bytes;
	usz     len;
}
fn char[] CodePoint.symbol(&self) @inline => self.bytes[:self.len];

<*
 Decode a single‑byte codepage byte buffer into a UTF‑8 string.

 @param [&inout] allocator : "Allocator used for the returned string buffer."
 @param src                : "Input byte array in the given code page."
 @param [&inout] table     : "Code page table describing the mapping for this encoding."
 @return "String in UTF-8."
*>
fn String? decode_codepage(Allocator allocator, char[] src, CodePageTable *table)
{
	DString buf = dstring::new(allocator);
	buf.reserve(decode_len(src, table));
	foreach (c: src)
	{
		buf.append_bytes(table.to_codepoint[c].symbol());
	}
	return buf.str_view();
}

<*
 Encode a UTF‑8 string into a single‑byte code page.

 @param [&inout] allocator : "Allocator used for the returned String."
 @param src                : "Input byte array in UTF-8"
 @param [&inout] table     : "Code page table describing the mapping for this encoding."
 @param replacement        : "Byte to emit when Unicode scalar cannot be represented in the target code page."
 @return "String in the given code page."
*>
fn String? encode_codepoints(Allocator allocator, char[] src, CodePageTable *table,
	char replacement = 0x1a)
{
	DString buf = dstring::new(allocator);
	buf.reserve(encode_len(src, table));

	usz n = src.len;
	for (usz i = 0; i < n;)
	{
		usz rem = n - i;
		rem = rem < 4 ? rem : 4;
		Char32 codepoint = conv::utf8_to_char32(&src[i], &rem)!;
		i += rem;

		usz index = sort::binarysearch(table.from_codepoint[..], codepoint,
		fn int(uint a, uint b){
			return (a & MASK) - (b & MASK);
		});

		uint encoded = table.from_codepoint[index];
		char byte = (char)(encoded >> 24);
		uint unicode = encoded & MASK;
		buf.append_char(unicode == codepoint ? byte: replacement);
	}
	return buf.str_view();
}

fn usz decode_len(char[] src, CodePageTable *table) @inline
{
	usz n;
	foreach (c: src) n += table.to_codepoint[c].len;
	return n;
}

fn usz encode_len(char[] src, CodePageTable *table) @inline
{
	return conv::utf8_codepoints((String)src);
}
`)!;
}

fn void? Emitter.emit_test_module(&self, OutStream out)
{
if (self.separate_files) self.emit_disclaimer(out);

io::fprintn(out, `module std::encoding::codepage_test;
import std::encoding::codepage::cp437;

fn void test_cp437() @test
{
	String want = "╔══════════════════════════════════════╗"
                      "║  SYSTEM STATUS: OK - 25°C ± 2°C      ║"
                      "║  Café Menu: Crème Brûlée .... £5.00  ║"
                      "╚══════════════════════════════════════╝";

	char[] bytes = x"C9CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDBB"
		x"BA202053595354454D205354415455533A204F4B202D203235F84320F12032F843202020202020BA"
		x"BA202043616682204D656E753A2043728A6D65204272966C8265202E2E2E2E209C352E30302020BA"
		x"C8CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDBC";

	@pool()
	{
		String got = (String)cp437::decode(tmem, bytes)!!;
		assert(got == want, "cp437 decoding failed: got=%s, want=%s", got, want);
		got = (String)cp437::encode(tmem, got[..])!!;
		assert(got == (String)bytes, "cp437 encoding failed: got=%s, want=%s", got, (String)bytes);

	};
}
`)!;
}

<*
 Codepoint stores an 8-bit character in the given codepage with the equivalent
 unicode value.
*>
struct Codepoint
{
	char   byte;    // Character
	uint   unicode; // Unicode
}
<*
 Compares the unicode values.
*>
fn bool Codepoint.less(&self, Codepoint other) => self.unicode < other.unicode;

fn void? Emitter.emit_codepage_module(&self, Path mapping, String cp_name, OutStream out) => @pool()
{
	// Open file
	File f = file::open_path(mapping, "r")!;
	defer (void)f.close();

	List{String} doc_comment;
	doc_comment.tinit();
	usz empty_comment_lines = 0;

	// Read code page.
	Codepoint[256] cps;
	usz i = 0;
	while (try line = io::treadline(&f))
	{
		if (try hash = line.index_of_char('#'))
		{
			String comment = line[hash+1..].trim();
			if (!comment.len) empty_comment_lines++;
			if (comment.len && empty_comment_lines < 2)
			{
				doc_comment.push(comment);
			}
			line = line[:hash];
		}
		if (!line.trim().len) continue;
		String[] parts = line.tsplit("\t", skip_empty: true);
		usz len = parts.len;
		switch (parts.len)
		{
			case 2:
				String byte = parts[0].trim();
				String uni  = parts[1].trim();
				if (!byte.len || !uni.len) break;
				if (try plus = uni.index_of_char('+')) uni = uni[:plus];
				if (byte.contains("+")) break;
				cps[i] = { byte.to_uchar()!, uni.to_uint()! };
			case 1:
				if (!parts[0].trim().len) break;
				cps[i] = { parts[0].to_uchar()!, 0x1a };
		}
		i++;
		if (i >= 256) break;
	}
	uint[256] utf8_dec = gen_decode_table(&cps)!;

	if (self.separate_files || self.emit_mapping_only)
	{
		self.emit_disclaimer(out);
	}

	io::fprintfn(out, "<*");
	io::fprintfn(out, " Module containing the codepage table for %s.\n", cp_name);
	io::fprintfn(out, " Header from the original mappings file:");
	io::fprintfn(out, " %s", string::join(tmem, doc_comment.array_view(), "\n "));
	io::fprintfn(out, "\n*>");
	io::fprintfn(out, "module std::encoding::codepage::%s;\n", cp_name);
	io::fprintfn(out, "fn char[]? decode(Allocator allocator, char[] bytes) @inline\n{");
	io::fprintfn(out, "\treturn codepage::decode_codepage(allocator, bytes, &%s);", cp_name);
	io::fprintfn(out, "\n}");
	io::fprintfn(out, "fn char[]? tdecode(Allocator allocator, char[] bytes) => decode(tmem, bytes)!;\n");
	io::fprintfn(out, "fn char[]? encode(Allocator allocator, char[] bytes) @inline\n{");
	io::fprintfn(out, "\treturn codepage::encode_codepoints(allocator, bytes, &%s);", cp_name);
	io::fprintfn(out, "\n}");
	io::fprintfn(out, "fn char[]? tencode(Allocator allocator, char[] bytes) => encode(tmem, bytes)!;\n");

	io::fprintfn(out, "CodePageTable %s @private = {", cp_name);

	// Write CodePage.utf8_enc.
	io::fprintfn(out, "\t.to_codepoint = {");
	io::fprint(out, "\t")!;
	foreach (j, cp: cps)
	{
		char[4] utf8;
		if (try n = conv::char32_to_utf8((Char32)cp.unicode, &utf8))
		{
			io::fprintf(out, "{ x\"%s\", %d }", hex::tencode(utf8[..]), n)!;
			if (j < 255) io::fprintf(out, ",")!;
		}
		io::fprintf(out, (j+1) % 4 == 0 ? "\n\t" : " ")!;
	}
	io::fprintn(out, "},")!;

	// Write CodePage.utf8_dec.
	io::fprintfn(out, "\t.from_codepoint = {");
	io::fprint(out, "\t")!;
	foreach (j, decode: utf8_dec)
	{
		io::fprintf(out, "0x%08x", decode)!;
		if (j < 255) io::fprintf(out, ",")!;
		io::fprintf(out, (j+1) % 6 == 0 ? "\n\t" : " ")!;
	}
	io::fprintn(out, "\t}")!;
	io::fprintn(out, "};\n")!;
}

fn uint[256]? gen_decode_table(Codepoint[256] *cps)
{
	uint[256] dec_table;
	// Pack the decode table (highest byte is the charset byte, the lower 3
	// bytes contain the unicode.
	foreach (i, cp: cps)
	{
		dec_table[i] = cp.byte << 24 | cp.unicode;
	}
	// Sort table by unicode so that we can use a binary search in the
	// decoding.
	sort::quicksort(&dec_table, fn int(uint a, uint b){ uint mask = (1<<24)-1; return (a&mask) - (b&mask);});
	return dec_table;
}

// getopt module implements a POSIX-compliant command-line parser.
module getopt;
import std::collections::list;

struct Option
{
	char flag;
	String arg;
}

faultdef UNKNOWN_OPTION, MISSING_ARGUMENT;

<*
 Parses command-line arguments..

 @param [in] args : "Strings of options."
 @param [in] optstring : "Specification of options."
 @param [out] optind : "Index of the first non-option argument"

 @require args.len > 0
 @return "Slice of options. Allocated on heap by default."
 @return? MISSING_ARGUMENT

*>
fn Option[]? getopts(Allocator allocator, String[] args, String optstring, int *optind = null)
{
	int i;

	List{Option} opts;
	opts.tinit(optstring.len);

	// remove program name
	args = args[1..];
	i++;

	// parse arguments
	while LOOP: (args.len) {
		String arg = args[0];

		switch {
		case arg == "--":
			i++;
			break LOOP;
		case arg == "-":
			break LOOP;
		case arg.len == 0:
		 	break LOOP;
		case arg[0] != '-':
		 	break LOOP;
		}

		arg = arg[1..];
		foreach (c : arg) {
			usz pos = optstring.index_of_char(c)!;
			bool hasArgument = pos+1 < optstring.len && optstring[pos+1] == ':';
			if (hasArgument) {
				if (args.len >= 2) {
					args = args[1..];
					i++;
					opts.push({.flag=c, .arg=args[0]});
				} else {
					return MISSING_ARGUMENT~;
				}
			} else {
				opts.push({.flag=c, .arg=""});
			}
		}
		args = args[1..];
		i++;
	}

	if (optind) {
		*optind = i;
	}

	return opts.to_array(allocator);
}
